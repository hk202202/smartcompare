# Database (SQLite locally; switch provider to postgresql in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
# Optional Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional AI advisor (any OpenAI-compatible endpoint). Falls back to rule-based summaries when unset.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Optional comma-separated platform allowlist, e.g. "amazon,flipkart,blinkit"
SMARTCOMPARE_PLATFORMS=""
